<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MonadUnlockTracker</RootNamespace>
    <AssemblyName>MonadUnlockTracker</AssemblyName>
    <Authors>MonadTracker Contributors</Authors>
    <Company>MonadTracker Contributors</Company>
    <Version>1.0.0</Version>
    <Description>Read-only tracker for MON token unlocks: sell pressure calculator and linear vesting schedule.</Description>
  </PropertyGroup>

</Project>
